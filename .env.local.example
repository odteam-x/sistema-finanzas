# Copia este archivo como ".env.local" y pega tus claves de Supabase.
# Las encuentras en: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# (Opcional) Asistente IA con Gemini — déjalo vacío para desactivarlo.
# Crea una API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Opcional) Solo para "npm run check:coherence" — NUNCA se usa en la app,
# solo en ese script de mantenimiento que corre por fuera del navegador.
# La sacas de: Supabase Dashboard → Project Settings → API → service_role.
# Bypasea RLS a propósito (así el script puede auditar todo) — por eso no
# lleva el prefijo NEXT_PUBLIC_, para que Next.js nunca la incluya en el
# bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=
