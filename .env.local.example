# Copia este archivo como ".env.local" y pega tus claves de Supabase.
# Las encuentras en: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# (Opcional) Asistente IA con Gemini — déjalo vacío para desactivarlo.
# Crea una API key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Opcional) Código personal de 6 dígitos como segundo factor al iniciar
# sesión. Sin esta variable la función queda desactivada y la app funciona
# igual — se prefiere eso a traer una llave por defecto, que sería la misma en
# todas las instalaciones y daría una falsa sensación de cifrado.
# Genera una con: openssl rand -hex 32
#
# Cifra el código en la base (AES-256-GCM) y firma la cookie que dice que este
# navegador ya lo verificó. Si la cambias, los códigos guardados dejan de
# poder descifrarse y hay que reasignarlos — trátala como una llave, no como
# una preferencia. Usa un valor DISTINTO en desarrollo y en producción.
PERSONAL_CODE_SECRET=

# (Opcional) Solo para "npm run check:coherence" y el cron de avisos diarios
# (app/api/cron/daily-alerts) — NUNCA se usa en flujos normales del navegador.
# La sacas de: Supabase Dashboard → Project Settings → API → service_role.
# Bypasea RLS a propósito (así puede leer/enviar avisos sin una sesión de
# usuario) — por eso no lleva el prefijo NEXT_PUBLIC_, para que Next.js nunca
# la incluya en el bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) Notificaciones push reales (Bloque 12). Genera un par nuevo con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública SÍ lleva NEXT_PUBLIC_ (el navegador la necesita para suscribirse);
# la privada NUNCA, solo el servidor la usa para firmar los envíos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del "mailto:" que exige el estándar VAPID (para que los
# proveedores de push puedan escribirte si algo va mal con tus envíos).
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# (Opcional) Protege app/api/cron/daily-alerts de invocaciones externas —
# Vercel Cron manda este valor en el header Authorization: Bearer <valor>.
# Genera cualquier cadena aleatoria larga, ej.: openssl rand -hex 32
CRON_SECRET=
